# Environment
NODE_ENV=production

# Server
PORT=10000

# Database - Production (Aiven MySQL)
# Replace with your Aiven connection string
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@mysql-xxxxx.aivencloud.com:12421/defaultdb?ssl-mode=REQUIRED"

# JWT - IMPORTANT: Generate secure secrets with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Replace with your frontend URL
CORS_ORIGIN=https://your-app.vercel.app
